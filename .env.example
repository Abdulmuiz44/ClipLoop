# Postgres connection string (Supabase/Postgres compatible)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cliploop

# Use demo auth fallback for local development
MOCK_MODE=true
DEMO_USER_EMAIL=cliploopapp@gmail.com

# Auth.js / NextAuth (used when MOCK_MODE=false)
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
# Production: set AUTH_URL=https://app.cliploop.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Use deterministic mock data generation
MOCK_LLM=false
INVITE_ONLY_MODE=true

# LLM provider (Mistral default for production chat)
LLM_PROVIDER=mistral
LLM_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Public app URL for billing redirects and canonical links
# Production: set NEXT_PUBLIC_APP_URL=https://app.cliploop.site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Instagram publishing integration (optional in local mock mode)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback

# Used to encrypt connected channel tokens at rest
ENCRYPTION_SECRET=

# HyperFrames renderer (optional)
HYPERFRAMES_ENABLED=false
HYPERFRAMES_BIN=hyperframes

# Lemon Squeezy billing
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_STARTER_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Credit pack variant IDs (one-time purchase products in Lemon Squeezy)
CREDIT_PACK_STARTER_VARIANT_ID=
CREDIT_PACK_PRO_VARIANT_ID=
CREDIT_PACK_RENDER_VARIANT_ID=
# Direct checkout URLs (alternative to variant-based flow)
CREDIT_PACK_STARTER_CHECKOUT_URL=
CREDIT_PACK_PRO_CHECKOUT_URL=
CREDIT_PACK_RENDER_CHECKOUT_URL=

# Talocode Cloud API key (primary — replaces CLIPLOOP_API_KEY)
TALOCODE_API_KEY=
# Talocode Cloud API base URL
TALOCODE_BASE_URL=https://api.talocode.xyz

# Legacy ClipLoop API key (deprecated — use TALOCODE_API_KEY instead)
CLIPLOOP_API_KEY=

# Gateway split scaffolding (local defaults; no public gateway enabled yet)
CLIPLOOP_GATEWAY_ENABLED=false
CLIPLOOP_GATEWAY_MODE=local_app
CLIPLOOP_GATEWAY_REQUIRE_API_KEY=false
CLIPLOOP_GATEWAY_RATE_LIMIT_PER_MINUTE=60
