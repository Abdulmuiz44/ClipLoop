{
  "name": "cliploop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "cd cliploop-vite && npm install --silent && npm run build && cp -r dist/* ../public/",
    "build": "next build",
    "start": "node scripts/db-fix.js && next start",
    "lint": "next lint",
    "test:billing": "LLM_PROVIDER=mock MOCK_LLM=true NODE_ENV=test tsx --test src/tests/billing-idempotency.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.44.2",
    "next": "15.5.15",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.16.3",
    "react": "19.1.6",
    "react-dom": "19.1.6",
    "sharp": "^0.34.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
